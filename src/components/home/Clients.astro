---
import { clients } from '../../data/clients';
---

<section class="section--tight section--line clients" aria-label="Clients">
  <div class="container">
    <p class="eyebrow">Client credibility strip</p>
    <ul class="clients__list">
      {clients.map((c) => (
        <li class="clients__item" data-reveal="fade">
          <a href={`/work/${c.caseStudySlug}/`} class="clients__link">
            <span class="clients__name display">{c.name}</span>
            <span class="clients__qual mono-sm">{c.qualifier}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients {
    padding-block: var(--space-2xl);
  }
  .clients__list {
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .clients__item {
    background: var(--bg-0);
  }
  .clients__link {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-l);
    min-height: 140px;
    transition: background var(--dur-1);
  }
  .clients__link:hover {
    background: var(--bg-1);
  }
  .clients__name {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .clients__link:hover .clients__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }
</style>
