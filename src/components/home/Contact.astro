---
import SectionHeader from '../ui/SectionHeader.astro';
import { profile } from '../../data/profile';
import { buildMailto } from '../../lib/hire';
const mailto = buildMailto();
---

<section class="section section--line contact" id="contact">
  <div class="container contact__grid">
    <SectionHeader
      n="05"
      label="Contact"
      title="Let’s <em>talk.</em>"
      lede="If you are deciding whether I can lead your engineering org or ship your product, write to me. I reply myself."
    />
    <div class="contact__actions">
      <a href={mailto} class="btn">Email a hire brief <span class="arrow">→</span></a>
      <ul class="contact__list">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.github} rel="me noopener" target="_blank">github.com/{profile.handle}</a></li>
        <li><a href="/resume.json">resume.json ↗</a></li>
      </ul>
      <p class="mono-sm"><span class="live" aria-hidden="true">●</span> {profile.availability}. {profile.remote}.</p>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  .contact__grid :global(.section-head) {
    margin-bottom: 0;
  }
  .contact__actions {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .contact__list {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step-0);
  }
  .live {
    color: var(--accent-text);
  }
</style>
