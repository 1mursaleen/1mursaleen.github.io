---
import SectionHeader from '../ui/SectionHeader.astro';
import { stackColumns, platformLayer } from '../../data/stack';
const rows: { key: keyof typeof stackColumns[0]; label: string }[] = [
  { key: 'provenOn', label: 'Proven on' },
  { key: 'backend', label: 'Backend' },
  { key: 'frontend', label: 'Frontend pairing' },
  { key: 'data', label: 'Data' },
  { key: 'languages', label: 'Languages' },
];
---

<section class="section section--line dual" id="stack">
  <div class="container">
    <SectionHeader
      n="06"
      label="Dual-stack proof map"
      title="Senior in <span class='accent'>both</span>.<br />Proven in production on each."
      lede="Most engineers are senior in one ecosystem and conversational in the other. Each column below is backed by national or enterprise-scale systems."
    />
    <div class="dual__grid">
      {stackColumns.map((col) => (
        <div class="dual__col card" data-reveal="fade" data-stack={col.id}>
          <h3 class="display display-4">{col.title}</h3>
          <dl class="dual__rows">
            {rows.map((r) => (
              <div class="dual__row">
                <dt class="mono-sm">{r.label}</dt>
                <dd>
                  <ul class="dual__tags">
                    {(col[r.key] as string[]).map((v) => (
                      <li class:list={['tag', { 'tag--proof': r.key === 'provenOn' }]}>{v}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
    <div class="dual__platform" data-reveal="fade">
      <p class="eyebrow">Platform layer, both stacks</p>
      <dl class="dual__platform-rows">
        {Object.entries(platformLayer).map(([k, v]) => (
          <div class="dual__row">
            <dt class="mono-sm">{k}</dt>
            <dd class="muted">{v.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .dual__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-l);
  }
  .dual__col {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }
  .dual__rows,
  .dual__platform-rows {
    display: grid;
    gap: var(--space-m);
    margin: 0;
  }
  .dual__row {
    display: grid;
    gap: var(--space-xs);
  }
  .dual__row dd {
    margin: 0;
  }
  .dual__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .tag--proof {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .dual__platform {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-m);
  }
  .dual__platform-rows {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
</style>
