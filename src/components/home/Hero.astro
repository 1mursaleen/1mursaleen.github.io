---
/**
 * Introduction. One narrator, one reader: I introduce myself to a decision-maker.
 * The globe is the only visual; the Drop (three pillars) follows, then the facts
 * and the credibility strip in IntroFacts.
 */
import GlHost from '../gl/GlHost.astro';
import { profile } from '../../data/profile';
import { buildMailto } from '../../lib/hire';
const mailto = buildMailto();
---

<header class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__kicker"><span class="live" aria-hidden="true">●</span> {profile.positioning}</p>
      <h1 class="display hero__title">
        <span class="hero__name">{profile.name}</span>
        <span class="hero__line">I’m an engineering leader who <em>ships with agents.</em></span>
      </h1>
      <div class="hero__intro">
        {profile.intro.map((para) => <p class="lede">{para}</p>)}
      </div>
      <div class="hero__ctas">
        <a href="#deliver" class="btn">How I deliver <span class="arrow">↓</span></a>
        <a href={mailto} class="btn">Hire me <span class="arrow">→</span></a>
        <a href="/resume.json" class="link-arrow">resume.json <span class="arrow">↗</span></a>
      </div>
    </div>
    <div class="hero__visual">
      <GlHost scene="globe" props={{ mode: 'hero' }} aspect="1 / 1" class="hero__globe" />
      <p class="mono-sm hero__caption">Islamabad → Dubai → Riyadh → Paris → orbit → everywhere</p>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) var(--space-2xl);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      max-width: 380px;
      margin-inline: auto;
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-l);
  }
  .hero__kicker {
    display: flex;
    gap: 0.7em;
    align-items: center;
  }
  .live {
    color: var(--accent-text);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  .hero__title {
    display: grid;
    gap: 0.25em;
    line-height: 0.9;
  }
  .hero__name {
    font-size: clamp(2.8rem, 0.8rem + 6vw, 6.2rem);
    letter-spacing: -0.04em;
  }
  .hero__line {
    font-size: clamp(1.6rem, 0.6rem + 2.6vw, 3rem);
    line-height: 1;
    max-width: 22ch;
    text-transform: none;
    letter-spacing: -0.02em;
  }
  .hero__intro {
    display: grid;
    gap: var(--space-m);
    max-width: 62ch;
  }
  .hero__intro .lede {
    font-size: var(--step-0);
  }
  .hero__intro .lede:first-child {
    font-size: var(--step-1);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
  }
  .hero__visual {
    position: sticky;
    top: 14vh;
  }
  .hero__caption {
    margin-top: var(--space-s);
    text-align: center;
  }
</style>
