---
import SectionHeader from '../ui/SectionHeader.astro';
import { aiThesis, principles, toolchain, orchestratorGraph as g } from '../../data/aiSystem';
import { evidence, evidenceAnswer } from '../../data/evidence';
import { getCaseStudy } from '../../data/caseStudies';
import { stackColumns, platformLayer } from '../../data/stack';
import { services } from '../../data/services';
import { buildMailto } from '../../lib/hire';
const rows: { key: keyof (typeof stackColumns)[0]; label: string }[] = [
  { key: 'provenOn', label: 'Proven on' },
  { key: 'backend', label: 'Backend' },
  { key: 'frontend', label: 'Frontend pairing' },
  { key: 'data', label: 'Data' },
  { key: 'languages', label: 'Languages' },
];
const engagementFor = (id: string) => (id === 'leadership' ? 'leadership-role' : id === 'advisory' ? 'advisory' : 'fixed-scope-delivery');
const proofs = [
  { cs: getCaseStudy('mortgage-automator')!, tag: 'Speed', line: 'A roughly one-year loan-origination roadmap shipped in a few months.' },
  { cs: getCaseStudy('primexis-aplitec')!, tag: 'Completeness', line: 'Regulated finance automation run agentically through the entire lifecycle by five engineers.' },
];
const support = evidence.filter((e) => e.kind === 'support');
const counter = evidence.filter((e) => e.kind === 'counterweight');
const byId = Object.fromEntries(g.nodes.map((n) => [n.id, n]));
const path = (a: string, b: string) => {
  const A = byId[a], B = byId[b];
  const dx = (B.x - A.x) * 0.5;
  return `M ${A.x} ${A.y} C ${A.x + dx} ${A.y}, ${B.x - dx} ${B.y}, ${B.x} ${B.y}`;
};
---

<section class="section section--line system ink" id="deliver">
  <div class="container">
    <SectionHeader
      n="02"
      label="How I deliver"
      title="I don’t “use AI tools.”<br />I run an <span class='accent'>operating model</span> built on them."
      lede={aiThesis}
    />

    <figure class="orch" data-orchestrator>
      <svg viewBox={`0 0 ${g.width} ${g.height}`} class="orch__svg" role="img" aria-labelledby="orch-title">
        <title id="orch-title">Orchestrator diagram: PRD feeds an orchestrator that spawns builders, reviewers and testers; CI enforces coverage; merges and decisions persist to versioned files.</title>
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
          </marker>
        </defs>
        <g class="orch__edges">
          {g.edges.map(([a, b]) => (
            <path d={path(a, b)} class:list={['orch__edge', { 'orch__edge--state': a === 'files' || b === 'files' }]} data-edge={`${a}-${b}`} marker-end="url(#arrow)" />
          ))}
        </g>
        <g class="orch__tokens">
          {['prd-orch', 'orch-b1', 'orch-b2', 'orch-b3', 'b1-rev', 'b2-test', 'b3-rev', 'rev-ci', 'test-ci', 'ci-merge', 'merge-files'].map((e) => (
            <circle r="5" class="orch__token" data-token={e} />
          ))}
        </g>
        <g class="orch__nodes">
          {g.nodes.map((n) => (
            <g class:list={['orch__node', `orch__node--${n.id}`]} transform={`translate(${n.x} ${n.y})`} data-node={n.id}>
              <rect x="-80" y="-30" width="160" height="60" rx="8" />
              <text y="-4" class="orch__label">{n.label}</text>
              <text y="16" class="orch__sub">{n.sub}</text>
            </g>
          ))}
        </g>
      </svg>
      <figcaption class="mono-sm">Spawn → build, review, test in parallel → CI → merge. State persists to versioned files and feeds the next session.</figcaption>
    </figure>

    <ol class="principles">
      {principles.map((p) => (
        <li class="principle" data-reveal="fade">
          <span class="mono num">{p.n}</span>
          <h3 class="display display-5">{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ol>

    <div class="proofs">
      <p class="eyebrow">Two proofs</p>
      <ul class="proofs__list">
        {proofs.map((p) => (
          <li class="card proofs__card">
            <span class="mono">{p.tag}</span>
            <h3 class="display display-5"><a href={`/work/${p.cs.slug}/`}>{p.cs.client}</a></h3>
            <p>{p.line}</p>
            <a class="link-arrow" href={`/work/${p.cs.slug}/`}>Read the case study <span class="arrow">→</span></a>
          </li>
        ))}
      </ul>
    </div>

    <details class="evidence">
      <summary>
        <span class="display display-5">The evidence, including the counterweights</span>
        <span class="mono-sm">What the studies actually show. Specific figures, never a flat “10×”.</span>
        <span class="evidence__plus" aria-hidden="true">+</span>
      </summary>
      <div class="evidence__body">
        <ol class="evidence__list">
          {support.map((e) => (
            <li class="evidence__row">
              <p class="mono-sm">{e.source}</p>
              <p>{e.claim}</p>
            </li>
          ))}
          {counter.map((e) => (
            <li class="evidence__row evidence__row--counter">
              <p class="mono-sm">Counterweight · {e.source}</p>
              <p>{e.claim}</p>
            </li>
          ))}
        </ol>
        <blockquote class="pull-quote">{evidenceAnswer}</blockquote>
      </div>
    </details>

    <div class="toolchain">
      <p class="eyebrow">The toolchain the system draws on</p>
      <ul class="toolchain__list">
        {toolchain.map((t) => <li class="tag">{t}</li>)}
      </ul>
      <p class="toolchain__note">The tools are not the headline. The orchestration, durable state, review gates and CI-enforced test suites are.</p>
      <a class="link-arrow" href="/blog/ai-orchestrated-delivery-system/">Read the full write-up <span class="arrow">↗</span></a>
    </div>

    <div class="dual">
      <div class="dual__head">
        <p class="eyebrow">Dual-stack proof map</p>
        <h3 class="display display-4">Senior in <em>both</em> stacks. Proven in production on each.</h3>
        <p class="dual__lede">Most engineers are senior in one ecosystem and conversational in the other. Each column is backed by national or enterprise-scale systems I shipped.</p>
      </div>
      <div class="dual__grid">
        {stackColumns.map((col) => (
          <div class="dual__col card" data-stack={col.id}>
            <h4 class="display display-5">{col.title}</h4>
            <dl class="dual__rows">
              {rows.map((r) => (
                <div class="dual__row">
                  <dt class="mono-sm">{r.label}</dt>
                  <dd>
                    <ul class="dual__tags">
                      {(col[r.key] as string[]).map((v) => (
                        <li class:list={['tag', { 'tag--proof': r.key === 'provenOn' }]}>{v}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <div class="dual__platform">
        <p class="eyebrow">Platform layer, both stacks</p>
        <dl class="dual__platform-rows">
          {Object.entries(platformLayer).map(([k, v]) => (
            <div class="dual__row">
              <dt class="mono-sm">{k}</dt>
              <dd class="muted">{v.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="offers">
      <div class="dual__head">
        <p class="eyebrow">Ways to work together</p>
        <h3 class="display display-4">Lead your org. Or ship your <em>module.</em></h3>
      </div>
      <ol class="offers__grid">
        {services.map((s) => (
          <li class:list={['card offers__card', { 'offers__card--primary': s.primary }]}>
            <span class="mono num">{s.tier}</span>
            <h4 class="display display-5">{s.title}</h4>
            <p class="offers__tagline">{s.tagline}</p>
            <p>{s.fit}</p>
            <div class="offers__actions">
              <a class="link-arrow" href={`/services/#${s.id}`}>View scope <span class="arrow">↗</span></a>
              <a class="link-arrow" href={buildMailto({ engagement: engagementFor(s.id) })}>Enquire <span class="arrow">→</span></a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .proofs {
    margin-top: var(--space-3xl);
    display: grid;
    gap: var(--space-m);
  }
  .proofs__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-l);
  }
  .proofs__card {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }
  .evidence {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .evidence summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3em var(--space-m);
    align-items: center;
    padding: var(--space-m) 0;
    cursor: pointer;
  }
  .evidence summary::-webkit-details-marker {
    display: none;
  }
  .evidence summary .mono-sm {
    grid-column: 1;
  }
  .evidence__plus {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: var(--step-2);
    transition: transform var(--dur-1) var(--ease-out);
  }
  .evidence[open] .evidence__plus {
    transform: rotate(45deg);
  }
  .evidence__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    padding-bottom: var(--space-xl);
    align-items: start;
  }
  @media (max-width: 980px) {
    .evidence__body {
      grid-template-columns: 1fr;
    }
  }
  .evidence__row {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .evidence__row--counter {
    background: var(--surface-warm);
    padding-inline: var(--space-m);
    margin-inline: calc(-1 * var(--space-m));
  }
  .orch {
    margin: 0 0 var(--space-3xl);
    display: grid;
    gap: var(--space-s);
  }
  .orch__svg {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--fg-dim);
  }
  .orch__edge {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .orch__edge--state {
    stroke-dasharray: 6 6;
    stroke: var(--fg-dim);
  }
  .orch__token {
    fill: var(--yellow);
    filter: drop-shadow(0 0 6px var(--accent-glow));
    opacity: 0;
  }
  .orch__node rect {
    fill: var(--bg-1);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .orch__node--orch rect,
  .orch__node--merge rect {
    stroke: var(--yellow);
    stroke-width: 2;
  }
  .orch__node--files rect {
    fill: var(--bg-2);
    stroke: var(--fg-muted);
    stroke-dasharray: 4 4;
  }
  .orch__label {
    fill: var(--fg);
    font-family: var(--font-display), sans-serif;
    font-weight: var(--w-bold);
    text-transform: uppercase;
    font-size: 20px;
    text-anchor: middle;
    letter-spacing: -0.01em;
  }
  .orch__sub {
    fill: var(--fg-muted);
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-anchor: middle;
    text-transform: uppercase;
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl) var(--space-l);
    counter-reset: p;
  }
  .principle {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    align-content: start;
  }
  .toolchain {
    margin-top: var(--space-3xl);
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .toolchain__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .toolchain__note {
    max-width: 60ch;
  }
  .dual,
  .offers {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-xl);
  }
  .dual__head {
    display: grid;
    gap: var(--space-s);
    max-width: 70ch;
  }
  .dual__lede {
    color: var(--fg-muted);
  }
  .dual__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-l);
  }
  .dual__col {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }
  .dual__rows,
  .dual__platform-rows {
    display: grid;
    gap: var(--space-m);
    margin: 0;
  }
  .dual__row {
    display: grid;
    gap: var(--space-xs);
  }
  .dual__row dd {
    margin: 0;
  }
  .dual__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .tag--proof {
    color: var(--ink);
    background: var(--paper);
    border-color: var(--paper);
  }
  .dual__platform {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-m);
  }
  .dual__platform-rows {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .offers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-l);
  }
  .offers__card {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }
  .offers__card--primary {
    border-color: var(--yellow);
  }
  .offers__tagline {
    font-size: var(--step-1);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .offers__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: auto;
  }
</style>
