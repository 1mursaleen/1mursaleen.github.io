---
import { booksRead, booksFraming } from '../../data/books';
---

<section class="section--tight section--line reading" id="reading">
  <div class="container reading__col">
    <p class="eyebrow">Reading</p>
    <h3 class="display display-4">{booksFraming}</h3>
    <ul class="reading__books">
      {booksRead.map((b) => (
        <li><b>{b.title}</b><span class="muted"> · {b.author}</span></li>
      ))}
    </ul>
    <a class="link-arrow" href="/books/">Full list, including the queue <span class="arrow">↗</span></a>
  </div>
</section>

<style>
  .reading {
    padding-block: var(--space-2xl);
  }
  .reading__col {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .reading__books {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step--1);
  }
</style>
