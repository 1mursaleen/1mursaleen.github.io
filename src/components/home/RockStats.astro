---
/**
 * Proof in numbers, told the orgnzm.studio way: a pinned stone that transforms
 * (ice → bloom → bare rock) as the rows scroll past it. Frames used with permission.
 */
import { stats } from '../../data/stats';
---

<section class="section--line rockstats" id="numbers">
  <div class="container rockstats__head">
    <p class="eyebrow"><span class="num">02</span> / Proof in numbers</p>
    <h2 class="display display-3 rockstats__title" data-reveal="lines">
      Shaped like stone.<br /><em>Pressure, care, and time.</em>
    </h2>
  </div>

  <div class="rockstats__body" data-rock-sequence>
    <div class="rockstats__pin" aria-hidden="true">
      <div class="rockstats__rock">
        <canvas data-rock-canvas width="700" height="700"></canvas>
        <img class="rockstats__poster" src="/org/rock/000.webp" alt="" width="700" height="700" loading="eager" />
      </div>
    </div>

    <ol class="rockstats__rows">
      {stats.map((s, i) => (
        <li class="rockstats__row container">
          <span class="mono-sm num rockstats__idx">{i + 1}</span>
          <span class="display rockstats__value num">{s.prefix}{s.display}{s.suffix}</span>
          <span class="mono rockstats__label">{s.label}</span>
          <span class="rockstats__gap" aria-hidden="true"></span>
          <span class="rockstats__source">{s.source}</span>
        </li>
      ))}
    </ol>
  </div>
  <p class="container rockstats__note">Client-scale figures describe the systems and organizations my work was part of, not personal attribution. Each source is named.</p>
</section>

<style>
  .rockstats {
    position: relative;
    background: var(--bg-0);
  }
  .rockstats__head {
    padding-block: var(--section-pad) var(--space-2xl);
    display: grid;
    gap: var(--space-s);
  }
  .rockstats__title {
    max-width: 22ch;
  }
  .rockstats__body {
    position: relative;
  }
  /* Only the stone is pinned: a zero-height sticky anchor holding the canvas. */
  .rockstats__pin {
    position: sticky;
    top: 50vh;
    height: 0;
    z-index: 2;
    pointer-events: none;
  }
  .rockstats__rock {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(240px, 28vw, 420px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }
  .rockstats__rock canvas,
  .rockstats__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rockstats__poster {
    opacity: 0;
  }
  html[data-motion-tier='static'] .rockstats__poster {
    opacity: 1;
  }
  html[data-motion-tier='static'] .rockstats__rock canvas {
    display: none;
  }

  /* One shared grid so every number column is as wide as the widest number. */
  .rockstats__rows {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 3rem auto minmax(0, 3fr) minmax(0, 3fr) minmax(0, 4fr);
    column-gap: var(--space-l);
  }
  .rockstats__row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    column-gap: var(--space-l);
    align-items: start;
    min-height: 26vh;
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  .rockstats__idx {
    padding-top: 0.6em;
  }
  .rockstats__value {
    font-size: clamp(2.4rem, 1.2rem + 4.6vw, 5.6rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .rockstats__label {
    color: var(--accent-text);
    text-transform: uppercase;
    padding-top: 0.6em;
    font-size: var(--step--1);
  }
  .rockstats__source {
    font-size: var(--step--1);
    color: var(--fg);
    max-width: 30ch;
    padding-top: 0.6em;
  }
  .rockstats__note {
    padding-block: var(--space-xl) var(--section-pad);
    font-size: var(--step--1);
    color: var(--fg-muted);
    max-width: 70ch;
  }
  @media (max-width: 900px) {
    .rockstats__pin {
      top: 60vh;
    }
    .rockstats__rock {
      width: min(52vw, 300px);
      opacity: 0.9;
    }
    .rockstats__rows {
      grid-template-columns: 2rem 1fr;
    }
    .rockstats__row {
      min-height: 0;
      row-gap: var(--space-xs);
    }
    .rockstats__gap {
      display: none;
    }
    .rockstats__label,
    .rockstats__source {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>

<script>
  import { initRockSequence } from '../../lib/motion/sections/rockSequence';
  initRockSequence();
</script>
