---
import { sourceGroups } from '../../data/sources';
---

<section class="section--tight section--line sources" id="sources">
  <div class="container">
    <p class="eyebrow"><span class="num">14</span> / Sources</p>
    <p class="muted sources__lede">Every claim on this site is traceable. Client-scale figures come from public filings, investor decks, peer-reviewed papers and the organizations’ own sites.</p>
    <div class="sources__grid">
      {sourceGroups.map((g) => (
        <div class="sources__group">
          <p class="mono-sm">{g.title}</p>
          <ul>
            {g.links.map((l) => (
              <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sources {
    padding-block: var(--space-2xl);
  }
  .sources__lede {
    margin-top: var(--space-s);
    max-width: 70ch;
  }
  .sources__grid {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-l);
  }
  .sources__group {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .sources__group ul {
    display: grid;
    gap: 0.3em;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .sources__group a:hover {
    color: var(--accent-text);
  }
</style>
