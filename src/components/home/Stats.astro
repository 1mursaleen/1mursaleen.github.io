---
import { stats } from '../../data/stats';
import BigNumber from '../ui/BigNumber.astro';
---

<section class="section section--line stats ink" id="numbers">
  <div class="container">
    <p class="eyebrow"><span class="num">02</span> / Proof in numbers</p>
    <div class="stats__grid">
      {stats.map((s) => (
        <BigNumber
          value={s.display}
          label={s.label}
          counter={s.value}
          prefix={s.prefix}
          suffix={s.suffix}
          format={s.format}
          source={s.source}
          size="display-3"
        />
      ))}
    </div>
    <p class="mono-sm stats__note">Client-scale figures describe the systems and organizations my work was part of, not personal attribution. Each source is named.</p>
  </div>
</section>

<style>
  .stats__grid {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl) var(--space-l);
  }
  .stats__note {
    margin-top: var(--space-xl);
    max-width: 70ch;
  }
</style>
