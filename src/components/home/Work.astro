---
import SectionHeader from '../ui/SectionHeader.astro';
import { caseStudies } from '../../data/caseStudies';
import { secondaryProjects } from '../../data/secondary';
---

<section class="section section--line work" id="work">
  <div class="container">
    <SectionHeader
      n="07"
      label="Case studies"
      title="Seven systems.<br />Each with <span class='accent'>stakes.</span>"
      lede="National health infrastructure, a satellite operator’s ground estate, a Sequoia-backed HIS, Tribal climate monitoring, private lending, regulated French finance, and the events platform that went 20x."
    />
    <ol class="work__grid">
      {caseStudies.map((cs) => (
        <li class="work__card card card--interactive" data-reveal="fade" data-tilt>
          <a href={`/work/${cs.slug}/`} class="work__link">
            <div class="work__top">
              <span class="mono-sm num">0{cs.order}</span>
              <span class="mono-sm">{cs.period}</span>
            </div>
            <h3 class="display display-4 work__title">{cs.title}</h3>
            <p class="work__client">{cs.client} · {cs.domain}</p>
            <p class="work__summary">{cs.summary}</p>
            <ul class="work__numbers">
              {cs.numbers.slice(0, 3).map((n) => (
                <li><b class="num">{n.value}</b><span class="mono-sm">{n.label}</span></li>
              ))}
            </ul>
            <div class="work__foot">
              <span class="mono-sm">{cs.teamSize}</span>
              <span class="link-arrow">Read the case study <span class="arrow">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <div class="work__more" data-reveal="fade">
      <p class="eyebrow">More work</p>
      <ul class="work__secondary">
        {secondaryProjects.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener" class="work__secondary-name">{p.name} ↗</a>
            <p class="muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-l);
  }
  .work__card {
    padding: 0;
  }
  .work__link {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    height: 100%;
    align-content: start;
  }
  .work__top {
    display: flex;
    justify-content: space-between;
  }
  .work__title {
    font-size: var(--step-3);
  }
  .work__link:hover .work__title {
    color: var(--accent-text);
  }
  .work__client {
    font-size: var(--step-0);
  }
  .work__summary {
    font-size: var(--step--1);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .work__numbers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
  .work__numbers li {
    display: grid;
    gap: 0.2em;
  }
  .work__numbers b {
    font-family: var(--font-display), sans-serif;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    font-weight: var(--w-bold);
  }
  .work__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    margin-top: auto;
  }
  .work__more {
    margin-top: var(--space-3xl);
    display: grid;
    gap: var(--space-m);
  }
  .work__secondary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-l);
  }
  .work__secondary li {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .work__secondary-name {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--w-bold);
    font-size: var(--step-1);
  }
  .work__secondary-name:hover {
    color: var(--accent-text);
  }
</style>
