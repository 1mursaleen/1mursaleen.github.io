---
import { profile } from '../../data/profile';
const path = Astro.url.pathname;
const links = [
  { href: '/#journey', label: 'Journey' },
  { href: '/#work', label: 'Work' },
  { href: '/#system', label: 'System' },
  { href: '/services/', label: 'Services' },
  { href: '/blog/', label: 'Blog' },
  { href: '/books/', label: 'Books' },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="container site-nav__inner">
    <a href="/" class="site-nav__brand" aria-label={`${profile.name}, home`}>
      <span class="site-nav__mark" aria-hidden="true"></span>
      <span class="site-nav__name">{profile.name}</span>
      <span class="site-nav__role mono-sm">{profile.positioningShort}</span>
    </a>
    <ul class="site-nav__links">
      {links.map((l) => (
        <li><a href={l.href} class:list={['site-nav__link', { 'is-active': path.startsWith(l.href.replace('/#', '/x')) }]}>{l.label}</a></li>
      ))}
    </ul>
    <a href={`mailto:${profile.email}`} class="btn btn--accent site-nav__cta">Hire <span class="arrow">→</span></a>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--bg-0) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
  }
  .site-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 64px;
  }
  .site-nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-right: auto;
  }
  .site-nav__mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
  }
  .site-nav__name {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--w-bold);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .site-nav__role {
    display: none;
  }
  @media (min-width: 1100px) {
    .site-nav__role {
      display: inline;
      margin-left: var(--space-xs);
    }
  }
  .site-nav__links {
    display: none;
    gap: var(--space-m);
  }
  @media (min-width: 820px) {
    .site-nav__links {
      display: flex;
    }
  }
  .site-nav__link {
    color: var(--fg);
    font-size: var(--step-0);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color var(--dur-1);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active {
    text-decoration-color: var(--fg);
  }
  .site-nav__cta {
    padding: 0.6em 1.1em;
  }
</style>
