---
import type { Link } from '../../data/types';
interface Props {
  links: Link[];
  title?: string;
}
const { links, title = 'Sources' } = Astro.props;
---

<div class="sources">
  <p class="eyebrow">{title}</p>
  <ul class="sources__list">
    {links.map((l) => (
      <li><a href={l.href} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">↗</span></a></li>
    ))}
  </ul>
</div>

<style>
  .sources {
    display: grid;
    gap: var(--space-s);
  }
  .sources__list {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .sources__list a {
    text-decoration: none;
  }
  .sources__list a:hover {
    color: var(--accent-text);
  }
</style>
