---
import Base from '../layouts/Base.astro';
import Marquee from '../components/ui/Marquee.astro';
import SectionNav from '../components/ui/SectionNav.astro';
import Hero from '../components/home/Hero.astro';
import Drop from '../components/home/Drop.astro';
import IntroFacts from '../components/home/IntroFacts.astro';
import Orchestrator from '../components/home/Orchestrator.astro';
import Journey from '../components/home/Journey.astro';
import Volunteering from '../components/home/Volunteering.astro';
import Contact from '../components/home/Contact.astro';
import AgentReady from '../components/home/AgentReady.astro';
import Faq from '../components/home/Faq.astro';
import Writing from '../components/home/Writing.astro';
import Reading from '../components/home/Reading.astro';
---

<Base>
  <SectionNav />
  <main>
    <!-- 1 Introduction -->
    <Hero />
    <Drop />
    <IntroFacts />
    <Marquee />
    <!-- 2 How I deliver -->
    <Orchestrator />
    <!-- 3 Work and journey -->
    <Journey />
    <!-- 4 Volunteering -->
    <Volunteering />
    <!-- 5 Contact -->
    <Contact />
    <!-- Utility tail -->
    <AgentReady />
    <Faq />
    <Writing />
    <Reading />
  </main>
</Base>
